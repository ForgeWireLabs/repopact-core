+    /// Reconcile the canonical generated dashboard after its rendered bytes
+    /// have been materialized in this snapshot's repository. Only the
+    /// dashboard index entry, text projection, source-path membership, and
+    /// matching read-set fact are refreshed; topology and every other indexed
+    /// record remain from the same immutable generation. Returns false without
+    /// changing the snapshot if the file is no longer present, so callers can
+    /// retain the full-reopen path for that exceptional case.
+    pub fn refresh_materialized_dashboard(&mut self) -> bool {
+        let path = self.repository.root.join("audits/reports/dashboard.md");
+        let relative = self.repository.relative_path(&path);
+        if !path.is_file() {
+            return false;
+        }
+
+        self.index.dashboard = Some(IndexedRecord::text(
+            RecordRef::new(RecordKind::Dashboard, relative.clone(), relative.clone()),
+            path.clone(),
+        ));
+        if let Some(text) = self
+            .index
+            .dashboard
+            .as_ref()
+            .and_then(|record| record.text.as_ref())
+        {
+            self.index.text_files.insert(path.clone(), text.clone());
+        } else {
+            self.index.text_files.remove(&path);
+        }
+        if !self.index.source_paths.contains(&path) {
+            self.index.source_paths.push(path.clone());
+        }
+        self.index
+            .source_paths
+            .sort_by(|left, right| path_string(left).cmp(&path_string(right)));
+        self.index.source_paths.dedup();
+
+        self.read_set.facts.retain(|fact| fact.path != relative);
+        self.read_set.facts.push(ReadFact {
+            path: relative,
+            expected: self.repository.path_state(&path),
+        });
+        self.read_set = ReadSet::new(std::mem::take(&mut self.read_set.facts));
+        true
+    }
 }
 
