+    #[test]
+    fn materialized_dashboard_refresh_matches_a_fresh_snapshot() {
+        let root = temp_root("materialized-dashboard-refresh");
+        let dashboard = root.join("audits/reports/dashboard.md");
+        fs::create_dir_all(dashboard.parent().unwrap()).unwrap();
+
+        for initial in [None, Some("stale dashboard\n")] {
+            if let Some(contents) = initial {
+                fs::write(&dashboard, contents).unwrap();
+            } else {
+                let _ = fs::remove_file(&dashboard);
+            }
+
+            let mut candidate = RepositorySession::open(&root).snapshot();
+            fs::write(&dashboard, "fresh dashboard\r\n").unwrap();
+            assert!(candidate.refresh_materialized_dashboard());
+
+            let reopened = RepositorySession::open(&root).snapshot();
+            assert_eq!(candidate.topology, reopened.topology);
+            assert_eq!(candidate.index, reopened.index);
+            assert_eq!(candidate.read_set, reopened.read_set);
+        }
+
+        let mut candidate = RepositorySession::open(&root).snapshot();
+        let original = candidate.clone();
+        fs::remove_file(&dashboard).unwrap();
+        assert!(!candidate.refresh_materialized_dashboard());
+        assert_eq!(candidate.topology, original.topology);
+        assert_eq!(candidate.index, original.index);
+        assert_eq!(candidate.read_set, original.read_set);
+        fs::remove_dir_all(root).unwrap();
+    }
