+    fn ac7_median_p95(values: &[u128]) -> (u128, u128) {
+        let mut sorted = values.to_vec();
+        sorted.sort_unstable();
+        let middle = sorted.len() / 2;
+        let median = if sorted.len() % 2 == 0 {
+            (sorted[middle - 1] + sorted[middle]) / 2
+        } else {
+            sorted[middle]
+        };
+        let p95_rank = (95 * sorted.len() + 99) / 100;
+        (median, sorted[p95_rank - 1])
+    }
+
+    fn ac7_print_summary(case: &str, name: &str, values: Vec<u128>) {
+        let (median, p95) = ac7_median_p95(&values);
+        println!("SUMMARY,{case},{name},median_us={median},p95_nearest_rank_us={p95}");
+    }
